# Python virtualenv (recreate with: scripts/setup.sh)
.venv/

# Device backups / dumped images (huge, and contain personal data)
backups/*
!backups/.gitkeep
*.img
*.bin.dump

# Run logs
logs/*
!logs/.gitkeep
*.log

# edl runtime cache (auto-generated; contains device serial)
edl_config.json

# Rooting work: carved/patched images + unpack trees (generated, can be huge)
build/

# Build / auxiliary tools: ignore compiled binaries and local scratch tools,
# but keep our source tool and the vendored AOSP avbtool + test keys.
tools/*
!tools/setpermissive.c
!tools/avb/
tools/avb/*
!tools/avb/avbtool.py
!tools/avb/testkeys/
!tools/avb/testkeys/*

# Python caches
__pycache__/
*.py[cod]

# OS cruft
.DS_Store
